# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template carries no secrets and every contributor needs it
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets
.env.local

# the original prototypes keep their API keys inline; they stay on disk
# as reference but must never enter git history
/docs/spikes/

# editor and tooling scratch files
/*.md
!README.md

# python agent: its own virtualenv, bytecode, and local measurement logs
/agent/.venv/
__pycache__/
*.pyc
/agent/experiments/*_results.json

# issue texts being written (scripts/issue.mjs)
/issue-drafts/
