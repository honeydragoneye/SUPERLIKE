# ---------------------------------------------------------------
# Spotify — PKCE flow, so there is no client secret.
# The Client ID is public by design; the redirect URI below must be
# registered verbatim in the Spotify app dashboard.
# ---------------------------------------------------------------
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# ---------------------------------------------------------------
# Server-only keys. These must never reach the browser — no
# NEXT_PUBLIC_ prefix, and only ever read inside route handlers.
# ---------------------------------------------------------------
LASTFM_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------
# Chat agent: a separate local process (npm run agent). The default
# below is what `agent/server.py` listens on; change it only if you
# moved the agent.
# ---------------------------------------------------------------
# AGENT_URL=http://127.0.0.1:8765
